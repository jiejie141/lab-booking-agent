  "cards": [
    {
      "dot": "cyan",
      "title": "它和普通表单系统的差别",
      "items": [
        "预约失败时返回带取舍说明的备选方案，而不是一句「该时段不可预约」",
        "每条备选都标注放宽了哪一条约束（起始时间 / 同类设备 / 时长 / 顺延）"
      ]
    },
    {
      "dot": "rose",
      "title": "约束是硬约束",
      "items": [
        "设备需培训资质才放行，换时段解决不了",
        "资质过期 / 被撤销各是一句不同的话"
      ]
    },
    {
      "dot": "emerald",
      "title": "工程质量",
      "items": [
        "16.6k 行代码 · 1026 项测试 · CI 三版本矩阵",
        "33 条 API 带 OpenAPI 契约门禁 · 6 个数据库迁移"
      ]
    }
  ]
