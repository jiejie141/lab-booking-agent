{
  "name": "lab-booking-console",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "lab-booking-agent 控制台（React + Tailwind）。构建产物输出到 ../dist，由 api.py 托管。",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
