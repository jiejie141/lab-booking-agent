# ===========================================================================
# lab-booking-agent 环境变量样例
# 复制成 .env 即可生效（变量前缀固定为 LAB_）
# ===========================================================================

# ---- Agent 模式 -----------------------------------------------------------
# mock     : 离线确定性假模型（默认）。不联网、不需要 key，全流程与评测都能跑。
# live     : 直连 OpenAI 兼容接口，需要下面三个变量。
# degraded : 关掉 Agent，退化为「引导式表单」。用来演示「模型挂了业务照样能跑」。
LAB_APP_MODE=mock

# ---- 真实模型（仅 LAB_APP_MODE=live 时需要） -------------------------------
# 任何 OpenAI 兼容端点都行（官方 / 中转 / 本地 ollama 的 /v1）
LAB_LLM_BASE_URL=https://api.openai.com/v1
LAB_LLM_API_KEY=
LAB_LLM_MODEL=gpt-4o-mini

# ---- 数据库 ---------------------------------------------------------------
# 本地默认 SQLite，开箱即跑。
# 走 docker-compose 时改成：postgresql+asyncpg://lab:lab@db:5432/lab
# LAB_DATABASE_URL=sqlite+aiosqlite:///./lab_booking.db

# ---- 执行模式与 Harness（Agent 运行时） -------------------------------------
# deterministic : 条件边决定调哪个工具，模型只做语言层（默认）。
#                 高风险业务走这条：不会出现「该查可用性却直接下单」。
# react         : 模型通过 function calling 自己选工具、看结果、再决定。
#                 通用 Agent 场景走这条。两条路径共用同一份工具注册表，
#                 对外返回同样的响应结构，所以前端/评测不需要区分。
LAB_EXECUTION_MODE=deterministic

# 上下文预算（token，按 CJK 感知的估算，非精确分词）。
# 组装时的裁剪顺序是确定的：system + 当前消息 + **这一轮刚拿到的工具结果**
# 永不丢弃（丢最后一个会让 ReAct 循环不收敛），然后才是历史 → 摘要 → 较早的工具轮次。
# 调到小于必需项时会照发并在 trace 里标 "超预算" —— 不会静默丢关键上下文。
LAB_CONTEXT_MAX_TOKENS=3000

# ReAct 循环的步数上限。用尽仍未收敛会如实返回 max_steps 并降级，
# 不会编一句话假装完成。
LAB_REACT_MAX_STEPS=6

# 是否允许模型自行触发写操作（create_reservation / cancel_reservation）。
# **默认 false，不要随手改成 true**：模型没有后果意识，误下单对用户是真实损失。
# 写操作仍可由业务代码（确认后的动作）执行，只是模型看不见也点不到。
LAB_REACT_ALLOW_SIDE_EFFECTS=false

# 单次工具结果回喂给模型的字符上限。超过就从头部截断并标注
# 「结果已截断，原始 N 字符」—— 模型必须知道自己看的是节选，
# 否则它会基于残缺内容接着编。结构化结果不受影响（响应层拿的是完整对象）。
LAB_TOOL_RESULT_LIMIT=1200

# ---- 检索 -----------------------------------------------------------------
# bm25   : 手写 BM25，零依赖（默认）
# vector : 需要 chromadb
# hybrid : BM25 + 向量，RRF 融合；缺 chromadb 时自动回退 bm25 并给出原因
LAB_RETRIEVAL_BACKEND=bm25
LAB_RRF_K=60

# ---- 服务 -----------------------------------------------------------------
LAB_HOST=127.0.0.1
LAB_PORT=8200

# ---- 认证与授权（P0-2） ---------------------------------------------------
# 签发 JWT 用的密钥。**生产必须换成随机长串**，否则任何人可自签管理员令牌。
# 留空或保持默认值时，启动会在日志里打醒目警告（uses_default_secret 判定）。
#   生成一条：python -c "import secrets;print(secrets.token_urlsafe(48))"
LAB_JWT_SECRET=
# 令牌有效期（分钟）
LAB_JWT_TTL_MINUTES=120
# scrypt 的 N 参数（CPU/内存成本）。默认 2^14 ≈ 单次哈希 140ms。
# 测试里会调到 2^10 以免拖慢用例，生产别降。
LAB_PASSWORD_KDF_N=16384

# ---- 边界加固（P0-3） -----------------------------------------------------
# 请求体上限（字节）。超过返回 413，未声明长度返回 411。
LAB_MAX_BODY_BYTES=65536
# /api/agent/chat 按**用户**维度的限流（次/分钟）。0 = 关闭。
# 按用户而不是按 IP：校园网出口 IP 天然共享，按 IP 会互相误伤。
LAB_RATE_LIMIT_PER_MINUTE=30
# CORS 白名单，逗号分隔。**留空 = 不发任何 CORS 头**（默认拒绝），
# 不要为了跑通前端就写 *：写 * 等于给所有站点开放带凭据的跨域。
LAB_CORS_ORIGINS=
# 审计日志开关（登录成功/失败、下单、取消、管理员读全量、越权被拒）
LAB_AUDIT_ENABLED=true

# ---- 后台清扫（P1-2） ------------------------------------------------------
# 三件事会随时间自己变坏，且没有任何用户操作会去修它们：
#   ① 忘刷出场的凭证（人会再也进不了任何房间）② 过期预约仍占着时段
#   ③ 审计表与通行流水只增不减
# 开关与间隔。关掉它**不会**让门禁失守 —— 凭证过期由核验自己判定，
# 这里只是把「假占用」收回来（见 README §7）。
LAB_SWEEP_ENABLED=true
LAB_SWEEP_INTERVAL_SECONDS=300
# 关门后多久算「他一定走了」，可以替他收尾。**刻意不用凭证的 valid_to**：
# 那是入场窗口的上限，不是离场时间，拿它当依据会把仍在做实验的人踢出在馆名单。
LAB_PERMIT_CHECKOUT_GRACE_MINUTES=30
# 归档保留期（天）。超过的导出成 JSONL 后从库里删除；**先落盘、后删除**。
LAB_AUDIT_RETENTION_DAYS=90
LAB_ACCESS_EVENT_RETENTION_DAYS=180
LAB_ARCHIVE_DIR=./var/archive
# ⚠️ 容器里跑时注意：写在容器可写层的文件会随容器重建一起消失，
#    必须挂一个卷（P1-5 验证 compose 时会一并处理）。
# 单批导出条数（分页）。第一次跑时表最大，一次全导出会把内存吃光。
LAB_ARCHIVE_BATCH_SIZE=5000

# ---- 并发 -----------------------------------------------------------------
# 抢同一时段失败后的重试次数；超了会明确回「繁忙请重试」
LAB_BOOKING_MAX_RETRY=5
