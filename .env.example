# ===========================================================================
# lab-booking-agent 环境变量样例
# 复制成 .env 即可生效（变量前缀固定为 LAB_）
# ===========================================================================

# ---- Agent 模式 -----------------------------------------------------------
# mock     : 离线确定性假模型（默认）。不联网、不需要 key，全流程与评测都能跑。
# live     : 直连 OpenAI 兼容接口，需要下面三个变量。
# degraded : 关掉 Agent，退化为「引导式表单」。用来演示「模型挂了业务照样能跑」。
LAB_APP_MODE=mock

# ---- 真实模型（仅 LAB_APP_MODE=live 时需要） -------------------------------
# 任何 OpenAI 兼容端点都行（官方 / 中转 / 本地 ollama 的 /v1）
LAB_LLM_BASE_URL=https://api.openai.com/v1
LAB_LLM_API_KEY=
LAB_LLM_MODEL=gpt-4o-mini

# ---- 数据库 ---------------------------------------------------------------
# 本地默认 SQLite，开箱即跑。
# 走 docker-compose 时改成：postgresql+asyncpg://lab:lab@db:5432/lab
# LAB_DATABASE_URL=sqlite+aiosqlite:///./lab_booking.db

# ---- 检索 -----------------------------------------------------------------
# bm25   : 手写 BM25，零依赖（默认）
# vector : 需要 chromadb
# hybrid : BM25 + 向量，RRF 融合；缺 chromadb 时自动回退 bm25 并给出原因
LAB_RETRIEVAL_BACKEND=bm25
LAB_RRF_K=60

# ---- 服务 -----------------------------------------------------------------
LAB_HOST=127.0.0.1
LAB_PORT=8200

# ---- 认证与授权（P0-2） ---------------------------------------------------
# 签发 JWT 用的密钥。**生产必须换成随机长串**，否则任何人可自签管理员令牌。
# 留空或保持默认值时，启动会在日志里打醒目警告（uses_default_secret 判定）。
#   生成一条：python -c "import secrets;print(secrets.token_urlsafe(48))"
LAB_JWT_SECRET=
# 令牌有效期（分钟）
LAB_JWT_TTL_MINUTES=120
# scrypt 的 N 参数（CPU/内存成本）。默认 2^14 ≈ 单次哈希 140ms。
# 测试里会调到 2^10 以免拖慢用例，生产别降。
LAB_PASSWORD_KDF_N=16384

# ---- 边界加固（P0-3） -----------------------------------------------------
# 请求体上限（字节）。超过返回 413，未声明长度返回 411。
LAB_MAX_BODY_BYTES=65536
# /api/agent/chat 按**用户**维度的限流（次/分钟）。0 = 关闭。
# 按用户而不是按 IP：校园网出口 IP 天然共享，按 IP 会互相误伤。
LAB_RATE_LIMIT_PER_MINUTE=30
# CORS 白名单，逗号分隔。**留空 = 不发任何 CORS 头**（默认拒绝），
# 不要为了跑通前端就写 *：写 * 等于给所有站点开放带凭据的跨域。
LAB_CORS_ORIGINS=
# 审计日志开关（登录成功/失败、下单、取消、管理员读全量、越权被拒）
LAB_AUDIT_ENABLED=true

# ---- 并发 -----------------------------------------------------------------
# 抢同一时段失败后的重试次数；超了会明确回「繁忙请重试」
LAB_BOOKING_MAX_RETRY=5
