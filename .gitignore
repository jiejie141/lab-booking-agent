# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---- 本地配置（可能含密钥）----
# 以前这一项漏了：一旦有人把真实密钥写进 .env，`git add -A` 就会把它带进仓库。
# 密钥一旦进过版本库就该作废，所以这里在源头挡住，而不是靠"记得别提交"。
.env
.env.local

# ---- 本地数据 ----
# 开发库与 SQLite 的 WAL 伴生文件：属于运行态，不入库
*.db
*.db-shm
*.db-wal

# ---- 运行日志与临时产物 ----
*.log
# 后台清扫导出的归档（P1-2）：属于运行态数据，不入库
var/

# ---- 本地配置（含密钥） ----
.env

# ---- 编辑器 / 系统 ----
.vscode/
.idea/
.DS_Store
Thumbs.db
