# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
# 覆盖率产物：由 CI 与本地 --cov 生成，属于运行态
# （不入库，否则每次跑完都会多一个未跟踪文件，也容易误提交）
.coverage
.coverage.*
htmlcov/
coverage.xml

# ---- 本地配置（可能含密钥）----
# 以前这一项漏了：一旦有人把真实密钥写进 .env，`git add -A` 就会把它带进仓库。
# 密钥一旦进过版本库就该作废，所以这里在源头挡住，而不是靠"记得别提交"。
.env
.env.local

# ---- 本地数据 ----
# 开发库与 SQLite 的 WAL 伴生文件：属于运行态，不入库
*.db
*.db-shm
*.db-wal

# ---- 运行日志与临时产物 ----
*.log
# 后台清扫导出的归档（P1-2）：属于运行态数据，不入库
var/

# ---- 前端构建链（src/lagent/web/ui）----
# node_modules 是依赖树，由 package-lock.json 唯一决定，一条 npm ci 就能重建。
# 它有几万个文件，一旦入库既撑爆 diff，也让 clone 慢得没法用。
node_modules/
# Vite 的类型缓存（--incremental 时写在 node_modules/.tmp 里，但别指望它）
*.tsbuildinfo

# ---- 编辑器 / 系统 ----
.vscode/
.idea/
.DS_Store
Thumbs.db

# CI 调查用的临时文件（curl 输出 / job 日志），不该进仓库 —— f98502f 误提交过一次
/_*.json
/_l*.txt

# 控制台构建产物，两条命令重建（npm run build && python build_web.py）：
#   dist/console.html            —— 单文件离线版
#   src/lagent/web/dist/         —— 开发版（Vite 产物，由 api.py 托管）
# 规则不带前导斜杠，两层都会命中；产物里有内容哈希，入库只会制造噪声 diff。
dist/
